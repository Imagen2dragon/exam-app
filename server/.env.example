# Copy to .env (never commit .env). The API key lives ONLY on the server, never in the APK.
ANTHROPIC_API_KEY=sk-ant-...
# Comma-separated device tokens. Generate each with:  python -c "import secrets;print(secrets.token_urlsafe(32))"
DEVICE_TOKENS=replace-with-a-long-random-token
# Requests per device per minute (AI calls cost money - keep this low)
RATE_LIMIT_PER_MIN=8
# Estimated AI spend allowed per device per day, in USD (0 = no limit). Resets at midnight USAGE_TZ.
DAILY_BUDGET_USD=5
USAGE_TZ=Africa/Addis_Ababa
# Where usage is recorded (only a hash of each device token is stored). Report: python usage_report.py
USAGE_DB=usage.db
